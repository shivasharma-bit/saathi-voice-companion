# Copy this file to .env and fill in real values.
# NEVER commit a real .env file — it is already in .gitignore.

# --- Rime (voice generation) ---
# Required for the real VoxForge demo. Without it, Saathi still runs
# end-to-end but falls back to the browser's offline speech synthesis
# and clearly labels every turn as "fallback mode" in the UI.
RIME_API_KEY=
RIME_MODEL_ID=coda
RIME_DEFAULT_SPEAKER=lyra
# Confirmed real Hindi-capable Coda voices (from Rime's live catalog,
# checked 2026-08-09): "nadi" or "taru". Listen to both in the Rime
# dashboard (app.rime.ai) and pick whichever fits — no gender/age
# metadata was available to pick automatically. Catalogs change, so
# re-verify at https://docs.rime.ai/docs/voices if this ever fails.
RIME_HINDI_SPEAKER=nadi
RIME_TTS_URL=https://users.rime.ai/v1/rime-tts
RIME_TIMEOUT_SECONDS=12

# --- Vision (prescription photo parsing) ---
# Optional. Without this key, the "Upload prescription photo" flow
# still works — the photo is shown, the caregiver just fills in the
# medicine/schedule fields by hand instead of getting them auto-read.
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-sonnet-4-6

# --- Qdrant (memory + case similarity search) ---
# QDRANT_MODE=local uses an embedded on-disk Qdrant instance — no
# account, no network needed. Switch to "cloud" + fill the two fields
# below to point at a real Qdrant Cloud cluster.
QDRANT_MODE=local
QDRANT_LOCAL_PATH=./qdrant_data
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=patient_memory
QDRANT_VECTOR_SIZE=64

# --- Patient registry ---
# Where caregiver-added/edited family members are persisted (JSON
# file, gitignored). Leave as default unless you know you need to
# change it.
PATIENT_STORE_PATH=

# --- Product logic ---
# Consecutive missed doses required before a caregiver alert fires.
ESCALATION_THRESHOLD=2
MAX_CLARIFYING_REASKS=2

# --- Server ---
HOST=0.0.0.0
PORT=8000
